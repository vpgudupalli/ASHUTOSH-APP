{
  "name": "risk-navigator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ashutosh Services Risk Navigator - multi-user patient risk stratification with live updates",
  "scripts": {
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "local": "npm run build && node --env-file-if-exists=.env server/index.js",
    "dev:client": "vite client",
    "build": "vite build client",
    "start": "node server/index.js"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-static": "^0.516.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
